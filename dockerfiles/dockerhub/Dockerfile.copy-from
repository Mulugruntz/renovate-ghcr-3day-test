# CASE 3 — COPY --from=<image>  (SUPPORTED: extract.ts copyFromRegex)
# This is the pattern the uv docs recommend. Expect version + digest PRs.
FROM debian:trixie-slim
COPY --from=astral/uv:0.12.14-trixie-slim@sha256:45d66bb5a1027a9026e35743755860fb888b4b0a19fb0ba3e31e31b094005afe /uv /uvx /usr/local/bin/

# CASE 3b — extra flags before --from (SUPPORTED: regex allows '--[a-z]+(=...)?' repeats)
COPY --link --from=astral/uv:0.12.14-trixie-slim@sha256:45d66bb5a1027a9026e35743755860fb888b4b0a19fb0ba3e31e31b094005afe /uv /usr/local/bin/uv-copy2

RUN uv --version
