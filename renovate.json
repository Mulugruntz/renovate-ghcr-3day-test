{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard - ghcr.io 3-day hold test",

  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,

  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+\\w+=(?<currentValue>\\S+)"
      ]
    }
  ],

  "packageRules": [
    {
      "description": "LANE A - the requested 3-day cooldown on ghcr.io pulls. NOTE: ghcr.io exposes no release timestamps to the docker datasource, so with internalChecksFilter=strict these stay pending indefinitely rather than for 3 days. See README.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "LANE C - same 3-day cooldown, but driven by a datasource that actually has timestamps. This one behaves as intended.",
      "matchDatasources": ["github-releases", "github-tags"],
      "matchPackageNames": ["astral-sh/uv"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "LANE X - the requested 3-day cooldown on DockerHub pulls.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/**", "astral/uv"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "LANE Y - same 3-day cooldown, but driven by a datasource that actually has timestamps. This one behaves as intended.",
      "matchDatasources": ["github-releases", "github-tags"],
      "matchPackageNames": ["astral/uv"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "CONTROL - Docker Hub image. The docker datasource does report timestamps here (tag_last_pushed), so the cooldown is evaluated normally.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    }
  ]
}
