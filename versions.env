# Two ways to track the SAME upstream project, so you can compare how
# minimumReleaseAge behaves per datasource on a single Renovate run.

# LANE A — docker datasource against ghcr.io.
# ghcr.io serves no release timestamps, so with the default
# minimumReleaseAgeBehaviour=timestamp-required every candidate is marked
# pending and (under internalChecksFilter=strict) no PR ever opens.
# renovate: datasource=docker depName=ghcr.io/astral-sh/uv versioning=docker
UV_VIA_DOCKER=0.12.7-trixie-slim

# LANE C — github-releases datasource against the upstream repo.
# This datasource DOES provide release timestamps, so the 3-day cooldown
# behaves as intended: it holds back releases younger than 3 days and offers
# the newest release that has aged out.
# renovate: datasource=github-releases depName=astral-sh/uv versioning=semver
UV_VIA_GH_RELEASES=0.12.7
